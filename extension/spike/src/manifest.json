{
  "manifest_version": 3,
  "name": "AnnotRec (spike)",
  "version": "0.0.1",
  "description": "Record any tab with a microphone, freeze the page and draw on it, and follow the active tab. Spike build.",
  "permissions": ["desktopCapture", "offscreen", "sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "AnnotRec" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
