{
  "manifest_version": 3,
  "name": "AnnotRec",
  "version": "3.0.0",
  "description": "Record any tab with your microphone, freeze the page and draw on it while you talk. One MP4 made on your own computer.",
  "permissions": [
    "offscreen",
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "AnnotRec",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-record": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop recording"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume the recording"
    },
    "toggle-draw": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Freeze the page to draw on it, or go live again"
    }
  },
  "short_name": "AnnotRec",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
